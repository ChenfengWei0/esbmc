8121:7:0","valueSize":1},{"declaration":1381,"isOffset":false,"isSlot":false,"src":"58507:7:0","valueSize":1},{"declaration":1398,"isOffset":false,"isSlot":false,"src":"56488:15:0","valueSize":1},{"declaration":1398,"isOffset":false,"isSlot":false,"src":"58240:15:0","valueSize":1},{"declaration":1386,"isOffset":false,"isSlot":false,"src":"52362:14:0","valueSize":1},{"declaration":1386,"isOffset":false,"isSlot":false,"src":"55511:14:0","valueSize":1},{"declaration":1373,"isOffset":false,"isSlot":false,"src":"52502:7:0","valueSize":1},{"declaration":1373,"isOffset":false,"isSlot":false,"src":"54026:7:0","valueSize":1},{"declaration":1373,"isOffset":false,"isSlot":false,"src":"57205:7:0","valueSize":1},{"declaration":1378,"isOffset":false,"isSlot":false,"src":"53734:7:0","valueSize":1},{"declaration":1378,"isOffset":false,"isSlot":false,"src":"55367:7:0","valueSize":1},{"declaration":1378,"isOffset":false,"isSlot":false,"src":"55777:7:0","valueSize":1},{"declaration":1378,"isOffset":false,"isSlot":false,"src":"56206:7:0","valueSize":1},{"declaration":1378,"isOffset":false,"isSlot":false,"src":"58098:7:0","valueSize":1},{"declaration":1378,"isOffset":false,"isSlot":false,"src":"58484:7:0","valueSize":1},{"declaration":1378,"isOffset":false,"isSlot":false,"src":"58899:7:0","valueSize":1},{"declaration":1369,"isOffset":false,"isSlot":false,"src":"53757:5:0","valueSize":1},{"declaration":1369,"isOffset":false,"isSlot":false,"src":"55390:5:0","valueSize":1},{"declaration":1369,"isOffset":false,"isSlot":false,"src":"55800:5:0","valueSize":1},{"declaration":1369,"isOffset":false,"isSlot":false,"src":"56229:5:0","valueSize":1},{"declaration":1369,"isOffset":false,"isSlot":false,"src":"56624:5:0","valueSize":1},{"declaration":1369,"isOffset":false,"isSlot":false,"src":"58922:5:0","valueSize":1}],"flags":["memory-safe"],"id":1409,"nodeType":"InlineAssembly","src":"52041:6948:0"}]},"documentation":{"id":1366,"nodeType":"StructuredDocumentation","src":"49999:1535:0","text":" @notice The function attempts to call the permit function on a given ERC20 token.\n @dev The function is designed to support a variety of permit functions, namely: IERC20Permit, IDaiLikePermit, IERC7597Permit and IPermit2.\n It accommodates both Compact and Full formats of these permit types.\n Please note, it is expected that the `expiration` parameter for the compact Permit2 and the `deadline` parameter\n for the compact Permit are to be incremented by one before invoking this function. This approach is motivated by\n gas efficiency considerations; as the unlimited expiration period is likely to be the most common scenario, and\n zeros are cheaper to pass in terms of gas cost. Thus, callers should increment the expiration or deadline by one\n before invocation for optimized performance.\n Note that the implementation does not perform dirty bits cleaning, so it is the responsibility of\n the caller to make sure that the higher 96 bits of the `owner` and `spender` parameters are clean.\n @param token The address of the ERC20 token on which to call the permit function.\n @param owner The owner of the tokens. This address should have signed the off-chain permit.\n @param spender The address which will be approved for transfer of tokens.\n @param permit The off-chain permit data, containing different fields depending on the type of permit function.\n @return success A boolean indicating whether the permit call was successful."},"id":1411,"implemented":true,"kind":"function","modifiers":[],"name":"tryPermit","nameLocation":"51548:9:0","nodeType":"FunctionDefinition","parameters":{"id":1376,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1369,"mutability":"mutable","name":"token","nameLocation":"51565:5:0","nodeType":"VariableDeclaration","scope":1411,"src":"51558:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$220","typeString":"contract IERC20"},"typeName":{"id":1368,"nodeType":"UserDefinedTyp