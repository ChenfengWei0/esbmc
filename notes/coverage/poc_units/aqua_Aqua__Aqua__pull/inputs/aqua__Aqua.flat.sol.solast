":1},{"declaration":2648,"isOffset":false,"isSlot":false,"src":"79466:7:0","valueSize":1},{"declaration":2648,"isOffset":false,"isSlot":false,"src":"79852:7:0","valueSize":1},{"declaration":2665,"isOffset":false,"isSlot":false,"src":"77833:15:0","valueSize":1},{"declaration":2665,"isOffset":false,"isSlot":false,"src":"79585:15:0","valueSize":1},{"declaration":2653,"isOffset":false,"isSlot":false,"src":"73707:14:0","valueSize":1},{"declaration":2653,"isOffset":false,"isSlot":false,"src":"76856:14:0","valueSize":1},{"declaration":2640,"isOffset":false,"isSlot":false,"src":"73847:7:0","valueSize":1},{"declaration":2640,"isOffset":false,"isSlot":false,"src":"75371:7:0","valueSize":1},{"declaration":2640,"isOffset":false,"isSlot":false,"src":"78550:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"75079:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"76712:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"77122:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"77551:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"79443:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"79829:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"80244:7:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"75102:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"76735:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"77145:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"77574:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"77969:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"80267:5:0","valueSize":1}],"flags":["memory-safe"],"id":2676,"nodeType":"InlineAssembly","src":"73386:6948:0"}]},"documentation":{"id":2633,"nodeType":"StructuredDocumentation","src":"71344:1535:0","text":" @notice The function attempts to call the permit function on a given ERC20 token.\n @dev The function is designed to support a variety of permit functions, namely: IERC20Permit, IDaiLikePermit, IERC7597Permit and IPermit2.\n It accommodates both Compact and Full formats of these permit types.\n Please note, it is expected that the `expiration` parameter for the compact Permit2 and the `deadline` parameter\n for the compact Permit are to be incremented by one before invoking this function. This approach is motivated by\n gas efficiency considerations; as the unlimited expiration period is likely to be the most common scenario, and\n zeros are cheaper to pass in terms of gas cost. Thus, callers should increment the expiration or deadline by one\n before invocation for optimized performance.\n Note that the implementation does not perform dirty bits cleaning, so it is the responsibility of\n the caller to make sure that the higher 96 bits of the `owner` and `spender` parameters are clean.\n @param token The address of the ERC20 token on which to call the permit function.\n @param owner The owner of the tokens. This address should have signed the off-chain permit.\n @param spender The address which will be approved for transfer of tokens.\n @param permit The off-chain permit data, containing different fields depending on the type of permit function.\n @return success A boolean indicating whether the permit call was successful."},"id":2678,"implemented":true,"kind":"function","modifiers":[],"name":"tryPermit","nameLocation":"72893:9:0","nodeType":"FunctionDefinition","parameters":{"id":2643,"nodeType":"ParameterList","parameters":[{"constant":false,"id":2636,"mutability":"mutable","name":"token","nameLocation":"72910:5:0","nodeType":"VariableDeclaration","scope":2678,"src":"72903:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$313","typeString":"c