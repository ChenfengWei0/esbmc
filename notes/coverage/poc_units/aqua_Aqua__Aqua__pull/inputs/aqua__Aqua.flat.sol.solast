12632:5:0","nodeType":"VariableDeclaration","scope":300,"src":"12624:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":294,"name":"uint256","nodeType":"ElementaryTypeName","src":"12624:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"12606:32:0"},"returnParameters":{"id":299,"nodeType":"ParameterList","parameters":[{"constant":false,"id":298,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":300,"src":"12657:4:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":297,"name":"bool","nodeType":"ElementaryTypeName","src":"12657:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"src":"12656:6:0"},"scope":313,"src":"12590:73:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"documentation":{"id":301,"nodeType":"StructuredDocumentation","src":"12669:297:0","text":" @dev Moves a `value` amount of tokens from `from` to `to` using the\n allowance mechanism. `value` is then deducted from the caller's\n allowance.\n Returns a boolean value indicating whether the operation succeeded.\n Emits a {Transfer} event."},"functionSelector":"23b872dd","id":312,"implemented":false,"kind":"function","modifiers":[],"name":"transferFrom","nameLocation":"12980:12:0","nodeType":"FunctionDefinition","parameters":{"id":308,"nodeType":"ParameterList","parameters":[{"constant":false,"id":303,"mutability":"mutable","name":"from","nameLocation":"13001:4:0","nodeType":"VariableDeclaration","scope":312,"src":"12993:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":302,"name":"address","nodeType":"ElementaryTypeName","src":"12993:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":305,"mutability":"mutable","name":"to","nameLocation":"13015:2:0","nodeType":"VariableDeclaration","scope":312,"src":"13007:10:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":304,"name":"address","nodeType":"ElementaryTypeName","src":"13007:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":307,"mutability":"mutable","name":"value","nameLocation":"13027:5:0","nodeType":"VariableDeclaration","scope":312,"src":"13019:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":306,"name":"uint256","nodeType":"ElementaryTypeName","src":"13019:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"12992:41:0"},"returnParameters":{"id":311,"nodeType":"ParameterList","parameters":[{"constant":false,"id":310,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":312,"src":"13052:4:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":309,"name":"bool","nodeType":"ElementaryTypeName","src":"13052:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"src":"13051:6:0"},"scope":313,"src":"12971:87:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":3235,"src":"10485:2575:0","usedErrors":[],"usedEvents":[247,256]},{"abstract":false,"baseContracts":[],"canonicalName":"IERC20Permit","contractDependencies":[],"contractKind":"interface","documentation":{"id":314,"nodeType":"StructuredDocumentation","src":"13234:1965:0","text":" @dev Interface of the ERC-20 Permit extension allowing approvals to be made via signatures, as defined in\n https://eips.ethereum.org/EIPS/eip-2612[ERC-2612].\n Adds the {permit} method, which can be used to change an account's ERC-20 allowance (see {IERC20-allowance}) by\n presenting a message signed by the account. By not relying on {IERC20-approve}, the token holder account doesn't\n need to send a transaction, and thus is not required to hold Ether at all.\n ==== Security Considerations\n There are two important considerations concerning the use of `permit`. The first is that a valid permit signature\n expresses an allowance, and it should not be assumed to convey additional meaning. In particular, it should not be\n considered as an intention to spend the allowance in any specific way. The second is that because permits have\n built-in replay protection and can be submitted by anyone, they can be frontrun. A protocol that uses permits should\n take this into consideration and allow a `permit` call to fail. Combining these two aspects, a pattern that may be\n generally recommended is:\n ```solidity\n function doThingWithPermit(..., uint256 value, uint256 deadline, uint8 v, bytes32 r, bytes32 s) public {\n     try token.permit(msg.sender, address(this), value, deadline, v, r, s) {} catch {}\n     doThing(..., value);\n }\n function doThing(..., uint256 value) public {\n     token.safeTransferFrom(msg.sender, address(this), value);\n     ...\n }\n ```\n Observe that: 1) `msg.sender` is used as the owner, leaving no ambiguity as to the signer intent, and 2) the use of\n `try/catch` allows the permit to fail and makes the code tolerant to frontrunning. (See also\n {SafeERC20-safeTransferFrom}).\n Additionally, note that smart contract wallets (such as Argent or Safe) are not able to produce permit signatures, so\n contracts should have entry points that don't rely on permit."},"fullyImplemented":false,"id":347,"linearizedBaseContracts":[347],"name":"IERC20Permit","nameLocation":"15210:12:0","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":315,"nodeType":"StructuredDocumentation","src":"15229:850:0","text":" @dev Sets `value` as the allowance of `spender` over ``owner``'s tokens,\n given ``owner``'s signed approval.\n IMPORTANT: The same issues {IERC20-approve} has related to transaction\n ordering also apply here.\n Emits an {Approval} event.\n Requirements:\n - `spender` cannot be the zero address.\n - `deadline` must be a timestamp in the future.\n - `v`, `r` and `s` must be a valid `secp256k1` signature from `owner`\n over the EIP712-formatted function arguments.\n - the signature must use ``owner``'s current nonce (see {nonces}).\n For more information on the signature format, see the\n https://eips.ethereum.org/EIPS/eip-2612#specification[relevant EIP\n section].\n CAUTION: See Security Considerations above."},"functionSelector":"d505accf","id":332,"implemented":false,"kind":"function","modifiers":[],"name":"permit","nameLocation":"16093:6:0","nodeType":"FunctionDefinition","parameters":{"id":330,"nodeType":"ParameterList","parameters":[{"constant":false,"id":317,"mutability":"mutable","name":"owner","nameLocation":"16117:5:0","nodeType":"VariableDeclaration","scope":332,"src":"16109:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":316,"name":"address","nodeType":"ElementaryTypeName","src":"16109:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":319,"mutability":"mutable","name":"spender","nameLocation":"16140:7:0","nodeType":"VariableDeclaration","scope":332,"src":"16132:15:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":318,"name":"address","nodeType":"ElementaryTypeName","src":"16132:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":321,"mutability":"mutable","name":"value","nameLocation":"16165:5:0","nodeType":"VariableDeclaration","scope":332,"src":"16157:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":320,"name":"uint256","nodeType":"ElementaryTypeName","src":"16157:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":323,"mutability":"mutable","name":"deadline","nameLocation":"16188:8:0","nodeType":"VariableDeclaration","scope":332,"src":"16180:16:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":322,"name":"uint256","nodeType":"ElementaryTypeName","src":"16180:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":325,"mutability":"mutable","name":"v","nameLocation":"16212:1:0","nodeType":"VariableDeclaration","scope":332,"src":"16206:7:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":324,"name":"uint8","nodeType":"ElementaryTypeName","src":"16206:5:0","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"},{"constant":false,"id":327,"mutability":"mutable","name":"r","nameLocation":"16231:1:0","nodeType":"VariableDeclaration","scope":332,"src":"16223:9:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":326,"name":"bytes32","nodeType":"ElementaryTypeName","src":"16223:7:0","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"},{"constant":false,"id":329,"mutability":"mutable","name":"s","nameLocation":"16250:1:0","nodeType":"VariableDeclaration","scope":332,"src":"16242:9:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":328,"name":"bytes32","nodeType":"ElementaryTypeName","src":"16242:7:0","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"}],"src":"16099:158:0"},"returnParameters":{"id":331,"nodeType":"ParameterList","parameters":[],"src":"16266:0:0"},"scope":347,"src":"16084:183:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"documentation":{"id":333,"nodeType":"StructuredDocumentation","src":"16273:294:0","text":" @dev Returns the current nonce for `owner`. This value must be\n included whenever a signature is generated for {permit}.\n Every successful call to {permit} increases ``owner``'s nonce by one. This\n prevents a signature from being used multiple times."},"functionSelector":"7ecebe00","id":340,"implemented":false,"kind":"function","modifiers":[],"name":"nonces","nameLocation":"16581:6:0","nodeType":"FunctionDefinition","parameters":{"id":336,"nodeType":"ParameterList","parameters":[{"constant":false,"id":335,"mutability":"mutable","name":"owner","nameLocation":"16596:5:0","nodeType":"VariableDeclaration","scope":340,"src":"16588:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":334,"name":"address","nodeType":"ElementaryTypeName","src":"16588:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"16587:15:0"},"returnParameters":{"id":339,"nodeType":"ParameterList","parameters":[{"constant":false,"id":338,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":340,"src":"16626:7:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":337,"name":"uint256","nodeType":"ElementaryTypeName","src":"16626:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"16625:9:0"},"scope":347,"src":"16572:63:0","stateMutability":"view","virtual":false,"visibility":"external"},{"documentation":{"id":341,"nodeType":"StructuredDocumentation","src":"16641:128:0","text":" @dev Returns the domain separator used in the encoding of the signature for {permit}, as defined by {EIP712}."},"functionSelector":"3644e515","id":346,"implemented":false,"kind":"function","modifiers":[],"name":"DOMAIN_SEPARATOR","nameLocation":"16836:16:0","nodeType":"FunctionDefinition","parameters":{"id":342,"nodeType":"ParameterList","parameters":[],"src":"16852:2:0"},"returnParameters":{"id":345,"nodeType":"ParameterList","parameters":[{"constant":false,"id":344,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":346,"src":"16878:7:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":343,"name":"bytes32","nodeType":"ElementaryTypeName","src":"16878:7:0","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"}],"src":"16877:9:0"},"scope":347,"src":"16827:60:0","stateMutability":"view","virtual":false,"visibility":"external"}],"scope":3235,"src":"15200:1689:0","usedErrors":[],"usedEvents":[]},{"abstract":false,"baseContracts":[],"canonicalName":"IERC7597Permit","contractDependencies":[],"contractKind":"interface","documentation":{"id":348,"nodeType":"StructuredDocumentation","src":"16970:120:0","text":" @title IERC7597Permit\n @dev A new extension for ERC-2612 permit, which has already been added to USDC v2.2."},"fullyImplemented":false,"id":363,"linearizedBaseContracts":[363],"name":"IERC7597Permit","nameLocation":"17101:14:0","nodeType":"ContractDefinition","nodes":[{"documentation":{"id":349,"nodeType":"StructuredDocumentation","src":"17122:460:0","text":" @notice Update allowance with a signed permit.\n @dev Signature bytes can be used for both EOA wallets and contract wallets.\n @param owner Token owner's address (Authorizer).\n @param spender Spender's address.\n @param value Amount of allowance.\n @param deadline The time at which the signature expires (unixtime).\n @param signature Unstructured bytes signature signed by an EOA wallet or a contract wallet."},"functionSelector":"9fd5a6cf","id":362,"implemented":false,"kind":"function","modifiers":[],"name":"permit","nameLocation":"17596:6:0","nodeType":"FunctionDefinition","parameters":{"id":360,"nodeType":"ParameterList","parameters":[{"constant":false,"id":351,"mutability":"mutable","name":"owner","nameLocation":"17620:5:0","nodeType":"VariableDeclaration","scope":362,"src":"17612:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":350,"name":"address","nodeType":"ElementaryTypeName","src":"17612:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":353,"mutability":"mutable","name":"spender","nameLocation":"17643:7:0","nodeType":"VariableDeclaration","scope":362,"src":"17635:15:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":352,"name":"address","nodeType":"ElementaryTypeName","src":"17635:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":355,"mutability":"mutable","name":"value","nameLocation":"17668:5:0","nodeType":"VariableDeclaration","scope":362,"src":"17660:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":354,"name":"uint256","nodeType":"ElementaryTypeName","src":"17660:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":357,"mutability":"mutable","name":"deadline","nameLocation":"17691:8:0","nodeType":"VariableDeclaration","scope":362,"src":"17683:16:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":356,"name":"uint256","nodeType":"ElementaryTypeName","src":"17683:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":359,"mutability":"mutable","name":"signature","nameLocation":"17722:9:0","nodeType":"VariableDeclaration","scope":362,"src":"17709:22:0","stateVariable":false,"storageLocation":"memory","typeDescriptions":{"typeIdentifier":"t_bytes_memory_ptr","typeString":"bytes"},"typeName":{"id":358,"name":"bytes","nodeType":"ElementaryTypeName","src":"17709:5:0","typeDescriptions":{"typeIdentifier":"t_bytes_storage_ptr","typeString":"bytes"}},"visibility":"internal"}],"src":"17602:135:0"},"returnParameters":{"id":361,"nodeType":"ParameterList","parameters":[],"src":"17746:0:0"},"scope":363,"src":"17587:160:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":3235,"src":"17091:658:0","usedErrors":[],"usedEvents":[]},{"abstract":false,"baseContracts":[],"canonicalName":"IPermit2","contractDependencies":[],"contractKind":"interface","documentation":{"id":364,"nodeType":"StructuredDocumentation","src":"17824:165:0","text":" @title IPermit2\n @dev Interface for a flexible permit system that extends ERC20 tokens to support permits in tokens lacking native permit functionality."},"fullyImplemented":false,"id":440,"linearizedBaseContracts":[440],"name":"IPermit2","nameLocation":"18000:8:0","nodeType":"ContractDefinition","nodes":[{"canonicalName":"IPermit2.PermitDetails","documentation":{"id":365,"nodeType":"StructuredDocumentation","src":"18015:356:0","text":" @dev Struct for holding permit details.\n @param token ERC20 token address for which the permit is issued.\n @param amount The maximum amount allowed to spend.\n @param expiration Timestamp until which the permit is valid.\n @param nonce An incrementing value for each signature, unique per owner, token, and spender."},"id":374,"members":[{"constant":false,"id":367,"mutability":"mutable","name":"token","nameLocation":"18415:5:0","nodeType":"VariableDeclaration","scope":374,"src":"18407:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":366,"name":"address","nodeType":"ElementaryTypeName","src":"18407:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":369,"mutability":"mutable","name":"amount","nameLocation":"18438:6:0","nodeType":"VariableDeclaration","scope":374,"src":"18430:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":368,"name":"uint160","nodeType":"ElementaryTypeName","src":"18430:7:0","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":371,"mutability":"mutable","name":"expiration","nameLocation":"18461:10:0","nodeType":"VariableDeclaration","scope":374,"src":"18454:17:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"},"typeName":{"id":370,"name":"uint48","nodeType":"ElementaryTypeName","src":"18454:6:0","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"}},"visibility":"internal"},{"constant":false,"id":373,"mutability":"mutable","name":"nonce","nameLocation":"18488:5:0","nodeType":"VariableDeclaration","scope":374,"src":"18481:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"},"typeName":{"id":372,"name":"uint48","nodeType":"ElementaryTypeName","src":"18481:6:0","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"}},"visibility":"internal"}],"name":"PermitDetails","nameLocation":"18383:13:0","nodeType":"StructDefinition","scope":440,"src":"18376:124:0","visibility":"public"},{"canonicalName":"IPermit2.PermitSingle","documentation":{"id":375,"nodeType":"StructuredDocumentation","src":"18506:310:0","text":" @dev Struct for a single token allowance permit.\n @param details Permit details including token, amount, expiration, and nonce.\n @param spender Address authorized to spend the tokens.\n @param sigDeadline Deadline for the permit signature, ensuring timeliness of the permit."},"id":383,"members":[{"constant":false,"id":378,"mutability":"mutable","name":"details","nameLocation":"18865:7:0","nodeType":"VariableDeclaration","scope":383,"src":"18851:21:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PermitDetails_$374_storage_ptr","typeString":"struct IPermit2.PermitDetails"},"typeName":{"id":377,"nodeType":"UserDefinedTypeName","pathNode":{"id":376,"name":"PermitDetails","nameLocations":["18851:13:0"],"nodeType":"IdentifierPath","referencedDeclaration":374,"src":"18851:13:0"},"referencedDeclaration":374,"src":"18851:13:0","typeDescriptions":{"typeIdentifier":"t_struct$_PermitDetails_$374_storage_ptr","typeString":"struct IPermit2.PermitDetails"}},"visibility":"internal"},{"constant":false,"id":380,"mutability":"mutable","name":"spender","nameLocation":"18890:7:0","nodeType":"VariableDeclaration","scope":383,"src":"18882:15:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":379,"name":"address","nodeType":"ElementaryTypeName","src":"18882:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":382,"mutability":"mutable","name":"sigDeadline","nameLocation":"18915:11:0","nodeType":"VariableDeclaration","scope":383,"src":"18907:19:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":381,"name":"uint256","nodeType":"ElementaryTypeName","src":"18907:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"name":"PermitSingle","nameLocation":"18828:12:0","nodeType":"StructDefinition","scope":440,"src":"18821:112:0","visibility":"public"},{"canonicalName":"IPermit2.PackedAllowance","documentation":{"id":384,"nodeType":"StructuredDocumentation","src":"18939:239:0","text":" @dev Struct for packed allowance data to optimize storage.\n @param amount Amount allowed.\n @param expiration Permission expiry timestamp.\n @param nonce Unique incrementing value for tracking allowances."},"id":391,"members":[{"constant":false,"id":386,"mutability":"mutable","name":"amount","nameLocation":"19224:6:0","nodeType":"VariableDeclaration","scope":391,"src":"19216:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":385,"name":"uint160","nodeType":"ElementaryTypeName","src":"19216:7:0","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":388,"mutability":"mutable","name":"expiration","nameLocation":"19247:10:0","nodeType":"VariableDeclaration","scope":391,"src":"19240:17:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"},"typeName":{"id":387,"name":"uint48","nodeType":"ElementaryTypeName","src":"19240:6: