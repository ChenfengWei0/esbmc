typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"2936:31:0"},"returnParameters":{"id":10,"nodeType":"ParameterList","parameters":[],"src":"2977:0:0"},"scope":97,"src":"2922:281:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"body":{"id":64,"nodeType":"Block","src":"3263:152:0","statements":[{"assignments":[40],"declarations":[{"constant":false,"id":40,"mutability":"mutable","name":"ok","nameLocation":"3278:2:0","nodeType":"VariableDeclaration","scope":64,"src":"3273:7:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":39,"name":"bool","nodeType":"ElementaryTypeName","src":"3273:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"id":47,"initialValue":{"commonType":{"typeIdentifier":"t_uint160","typeString":"uint160"},"id":46,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftExpression":{"arguments":[{"id":43,"name":"token","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":34,"src":"3291:5:0","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}}],"expression":{"argumentTypes":[{"typeIdentifier":"t_address","typeString":"address"}],"id":42,"isConstant":false,"isLValue":false,"isPure":true,"lValueRequested":false,"nodeType":"ElementaryTypeNameExpression","src":"3283:7:0","typeDescriptions":{"typeIdentifier":"t_type$_t_uint160_$","typeString":"type(uint160)"},"typeName":{"id":41,"name":"uint160","nodeType":"ElementaryTypeName","src":"3283:7:0","typeDescriptions":{}}},"id":44,"isConstant":false,"isLValue":false,"isPure":false,"kind":"typeConversion","lValueRequested":false,"nameLocations":[],"names":[],"nodeType":"FunctionCall","src":"3283:14:0","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"nodeType":"BinaryOperation","operator":">","rightExpression":{"hex