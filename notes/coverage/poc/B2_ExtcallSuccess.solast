dress","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":36,"mutability":"mutable","name":"amount","nameLocation":"3246:6:0","nodeType":"VariableDeclaration","scope":65,"src":"3238:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":35,"name":"uint256","nodeType":"ElementaryTypeName","src":"3238:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"3222:31:0"},"returnParameters":{"id":38,"nodeType":"ParameterList","parameters":[],"src":"3263:0:0"},"scope":97,"src":"3209:206:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"body":{"id":95,"nodeType":"Block","src":"5033:146:0","statements":[{"assignments":[74],"declarations":[{"constant":false,"id":74,"mutability":"mutable","name":"ok","nameLocation":"5048:2:0","nodeType":"VariableDeclaration","scope":95,"src":"5043:7:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":73,"name":"bool","nodeType":"ElementaryTypeName","src":"5043:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"id":78,"initialValue":{"commonType":{"typeIdentifier":"t_uint256","typeString":"uint256"},"id":77,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftExpression":{"id":75,"name":"tokenNum","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":68,"src":"5053:8:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"BinaryOperation","operator":">","rightExpression":{"hexValue":"313030","id":76,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5064:3:0","typeDescriptions":{"typeIdentifier":"t_rational_100_by_1","typeString":"int_const 100"},"value":"100"},"src":"5053:14:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"nodeType":"VariableDeclarationStatement","src":"5043:24:0"},{"condition":{"id":79,"name":"ok","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":74,"src":"5081:2:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"falseBody":{"id":93,"nodeType":"Block","src":"5132:41:0","statements":[{"expression":{"id":91,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftHandSide":{"id":87,"name":"tag","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":4,"src":"5146:3:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"Assignment","operator":"=","rightHandSide":{"commonType":{"typeIdentifier":"t_uint256","typeString":"uint256"},"id":90,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftExpression":{"id":88,"name":"amount","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":70,"src":"5152:6:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"BinaryOperation","operator":"+","rightExpression":{"hexValue":"32","id":89,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5161:1:0","typeDescriptions":{"typeIdentifier":"t_rational_2_by_1","typeString":"int_const 2"},"value":"2"},"src":"5152:10:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"src":"5146:16:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"id":92,"nodeType":"ExpressionStatement","src":"5146:16:0"}]},"id":94,"nodeType":"IfStatement","src":"5077:96:0","trueBody":{"id":86,"nodeType":"Block","src":"5085:41:0","statements":[{"expression":{"id":84,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftHandSide":{"id":80,"name":"tag","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":4,"src":"5099:3:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"Assignment","operator":"=","rightHandSide":{"commonType":{"typeIdentifier":"t_uint256","typeString":"uint256"},"id":83,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftExpression":{"id":81,"name":"amount","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":70,"src":"5105:6:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"BinaryOperation","operator":"+","rightExpression":{"hexValue":"31","id":82,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"5114:1:0","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"1"},"src":"5105:10:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"src":"5099:16:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"id":85,"nodeType":"ExpressionStatement","src":"5099:16:0"}]}}]},"documentation":{"id":66,"nodeType":"StructuredDocumentation","src":"3421:1546:0","text":"SECOND CONTROL, added because the first repair STILL failed and the\n reason looks like the coordinate's TYPE rather than the branch.\n MEASURED, `ctrl` above, `uint160(token) > 100`: 0 certified / 3 not, and\n `token`'s region came back IDENTICAL on both sides --\n     token: (0, 1461501637330902918203684832716283019655932542975)\n which is exactly 2^160 - 1, the full address range, on enc=6 AND enc=7.\n Refinement separated NOTHING on the branch variable. The driver's span\n for it is\n     'token': (0, 115792089237316195423570985008687907853269984665640564039457584007913129639935)\n i.e. the full uint256. So ~54 candidate values are spread over 2^256\n while every value the coordinate can actually take lies below 2^160: the\n fraction of the ladder that lands inside the type is 2^-96, and a\n boundary at 100 is invisible to it. B1's `ctrl` has the same boundary at\n 100 on a uint256 coordinate and DID separate (wrongly, at 6.8e75, but it\n separated), so the branch is not what differs.\n `ctrlU256` is `ctrl` with the SAME boundary and the SAME body on a\n uint256 parameter instead of an address. If it separates and `ctrl` does\n not, the ladder being laid over uint256 for a narrower-typed coordinate\n is the mechanism -- and that matters beyond this file, because\n msg.sender is an address coordinate on every farming arm and is named in\n the divergence of deposit's enc 3622/3623."},"functionSelector":"1097313a","id":96,"implemented":true,"kind":"function","modifiers":[],"name":"ctrlU256","nameLocation":"4981:8:0","nodeType":"FunctionDefinition","parameters":{"id":71,"nodeType":"ParameterList","parameters":[{"constant":false,"id":68,"mutability":"mutable","name":"tokenNum","nameLocation":"4998:8:0","nodeType":"VariableDeclaration","scope":96,"src":"4990:16:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":67,"name":"uint256","nodeType":"ElementaryTypeName","src":"4990:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":70,"mutability":"mutable","name":"amount","nameLocation":"5016:6:0","nodeType":"VariableDeclaration","scope":96,"src":"5008:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":69,"name":"uint256","nodeType":"ElementaryTypeName","src":"5008:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"4989:34:0"},"returnParameters":{"id":72,"nodeType":"ParameterList","parameters":[],"src":"5033:0:0"},"scope":97,"src":"4972:207:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":98,"src":"2864:2317:0","usedErrors":[],"usedEvents":[]}],"src":"32:5150:0"}