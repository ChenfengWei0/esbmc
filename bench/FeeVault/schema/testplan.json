{
  "manual": true,
  "_why_manual": "T2. Hand-written by a human to fix the SHAPE the emitter must consume. T3 replaces this file with one produced by the certification stage, and flips `manual` to false. Per R7 nothing carrying manual:true is ever counted in a conversion rate.",

  "contract": "FeeVault",
  "import": "../src/FeeVault.sol",

  "fixture": {
    "deployer": "TEST_CONTRACT",
    "constructor_args": [],
    "value": "0",
    "accounts": [
      { "name": "alice", "addr": "address(0xA11CE)" }
    ]
  },

  "unit": "withdraw(uint256)",
  "path_id": "withdraw:path:14",
  "_path_note": "amount accepted; discount APPLIES; fee stays UNDER the cap.",

  "params": [
    { "name": "amount", "sol_type": "uint256", "lo": "1000000000000000000", "hi": "3000000000000000000", "holes": [] },
    { "name": "disc",   "sol_type": "uint16",  "lo": "1",                   "hi": "249",                 "holes": [] }
  ],

  "pre_state": [
    {
      "accessor": "discountBps[alice]",
      "value": "disc",
      "via": { "kind": "call", "caller": "TEST_CONTRACT", "fn": "setDiscount", "args": ["alice", "disc"] }
    },
    {
      "accessor": "deposits[alice]",
      "value": "amount",
      "via": { "kind": "call", "caller": "alice", "fn": "deposit", "value": "amount", "args": [], "deal": "amount" }
    }
  ],

  "call": {
    "caller": "alice",
    "value": "0",
    "fn": "withdraw",
    "args": ["amount"],
    "returns": "net",
    "returns_type": "uint256"
  },

  "locals": [
    { "name": "rate", "sol_type": "uint256", "expr": "uint256(v.feeBps()) - uint256(disc)" },
    { "name": "fee",  "sol_type": "uint256", "expr": "amount * rate / 10000" }
  ],

  "assertions": [
    { "kind": "eq", "lhs": "net",              "rhs": "amount - fee", "msg": "net must be the amount less the discounted fee" },
    { "kind": "eq", "lhs": "v.deposits(alice)", "rhs": "0",           "msg": "the whole deposit must be withdrawn" },
    { "kind": "lt", "lhs": "fee",              "rhs": "v.maxFee()",   "msg": "the region must keep the fee under the cap" }
  ]
}
