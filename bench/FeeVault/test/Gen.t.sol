import "forge-std/Test.sol";
import "../src/FeeVault.sol";

contract FeeVaultGenTest is Test {
    FeeVault v;
    address alice = address(0xA11CE);

    function setUp() public {
        v = new FeeVault();
    }

    receive() external payable {}

    function test_withdraw_path_14(uint256 amount, uint16 disc) public {
        // The certified region: an interval per coordinate, minus punctures.
        amount = bound(amount, 1000000000000000000, 3000000000000000000);
        disc = uint16(bound(uint256(disc), 1, 249));

        // Pre-state the path requires.
        // discountBps[alice] = disc
        v.setDiscount(alice, disc);
        // deposits[alice] = amount
        vm.deal(alice, amount);
        vm.prank(alice);
        v.deposit{value: amount}();

        // The call under test.
        vm.prank(alice);
        uint256 net = v.withdraw(amount);

        uint256 rate = uint256(v.feeBps()) - uint256(disc);
        uint256 fee = amount * rate / 10000;

        // Oracles, proved over the region.
        assertEq(net, amount - fee, "net must be the amount less the discounted fee");
        assertEq(v.deposits(alice), 0, "the whole deposit must be withdrawn");
        assertLt(fee, v.maxFee(), "the region must keep the fee under the cap");
    }
}
